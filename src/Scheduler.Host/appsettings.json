{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost",
  "Kestrel": {
    "Endpoints": {
      "Management": {
        "Url": "http://127.0.0.1:5080"
      }
    }
  },
  "JobScheduler": {
    "DataRoot": "data",
    "DatabasePath": "data/jobscheduler.db",
    "ArtifactsRoot": "data/artifacts",
    "StagingRoot": "data/staging",
    "PackagePublicKeyPath": "keys/package-signing.pub.pem",
    "LogsRoot": "logs",
    "GlobalExecutionLimit": 8,
    "GracefulShutdownDrainTimeout": "00:01:00",
    "DefaultDrainPolicy": "Wait"
  }
}
